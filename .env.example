APP_KEY=
APP_URL=http://localhost:8080

DB_NAME=AlphaMaster
DB_USER=AlphaMaster
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

API_PORT=8080
ADMIN_PORT=3000
COMPOSE_PATH_SEPARATOR=:
# Production-safe default (APP_ENV=production, APP_DEBUG=false).
COMPOSE_FILE=docker-compose.yml:docker-compose.data.yml:docker-compose.backend.yml:docker-compose.admin.yml:docker-compose.ports.yml
# Local development ONLY (APP_DEBUG=true, source mounted). Never use on a server:
# COMPOSE_FILE=docker-compose.yml:docker-compose.data.yml:docker-compose.backend.yml:docker-compose.admin.yml:docker-compose.ports.yml:docker-compose.override.yml

# --- Auth / localization (Phase 1). Leave unset to use the compose defaults.
# APP_LOCALE=ar
# SANCTUM_STATEFUL_DOMAINS=admin.example.com
# CORS_ALLOWED_ORIGINS=https://admin.example.com
# SESSION_DOMAIN=.example.com
# SESSION_SECURE_COOKIE=true
# SANCTUM_ADMIN_TOKEN_TTL_DAYS=30
# SANCTUM_PUBLIC_TOKEN_TTL_DAYS=90

# --- First system owner (SystemOwnerSeeder). Not read by the running app: pass these only
# when seeding, then remove them. The password must meet the policy (12+ chars, letters and numbers).
#   docker exec -e OWNER_NAME=... -e OWNER_USERNAME=... -e OWNER_EMAIL=... -e OWNER_PASSWORD=... #     AlphaMaster-API php artisan db:seed --class=SystemOwnerSeeder --force
